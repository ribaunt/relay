{
  "name": "relay-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/generate-keys.mjs && concurrently -n auth,id -c cyan,magenta \"pnpm dev:auth\" \"pnpm dev:id\"",
    "dev:auth": "pnpm --filter @relay/auth dev",
    "dev:id": "pnpm --filter @relay/id dev",
    "dev:setup": "node scripts/generate-keys.mjs",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4"
}
